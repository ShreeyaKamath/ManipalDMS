<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Update the server name to match your SQL Server installation. Integrated security avoids storing a password here. -->
    <add name="PressDMS"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=PressDMS;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
