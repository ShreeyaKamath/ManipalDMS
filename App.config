<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Deployment-specific configuration should be provided by the hosting environment. -->
    <add name="PressDMS"
         connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=PressDMS;Integrated Security=SSPI;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
